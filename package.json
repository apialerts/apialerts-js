{
  "name": "apialerts",
  "version": "1.3.2",
  "description": "JavaScript/TypeScript SDK for apialerts.com",
  "author": "API Alerts",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apialerts/apialerts-js.git"
  },
  "keywords": [
    "apialerts",
    "notifications",
    "alerts",
    "monitoring"
  ],
  "bugs": {
    "url": "https://github.com/apialerts/apialerts-js/issues"
  },
  "homepage": "https://github.com/apialerts/apialerts-js#readme",
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
